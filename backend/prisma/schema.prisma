generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

// Beta Subscribers Model
model BetaSubscribers {
  id    String @id @default(uuid())
  email String @unique

  @@map("beta_subscribers")
  @@schema("public")
}

// User Model
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  email           String   @unique
  role            String   @default("USER")
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
  @@schema("public")
}

// Tour Related Models
model Country {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  dateCreated  DateTime  @default(now())
  dateModified DateTime? @updatedAt
  tours        Tour[]

  @@map("countries")
  @@schema("public")
}

model Park {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  type         String
  country      String
  countryCode  String?
  keyword      String
  dateCreated  DateTime  @default(now())
  dateModified DateTime? @updatedAt

  tourParks TourPark[]

  @@map("parks")
  @@schema("public")
}

model TourPark {
  tourId Int
  parkId Int

  tour Tour @relation(fields: [tourId], references: [id])
  park Park @relation(fields: [parkId], references: [id])

  @@id([tourId, parkId])
  @@map("_TourParks")
  @@schema("public")
}

model Operator {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  dateCreated  DateTime  @default(now())
  dateModified DateTime? @updatedAt
  tours        Tour[]

  @@map("operators")
  @@schema("public")
}

model TourImage {
  id           Int       @id @default(autoincrement())
  imageUrls    String
  dateCreated  DateTime  @default(now())
  dateModified DateTime? @updatedAt
  tourId       Int
  tourUniqueId String
  tour         Tour      @relation(fields: [tourId, tourUniqueId], references: [id, uniqueId], onDelete: Cascade)

  @@index([tourId, tourUniqueId])
  @@map("tour_images")
  @@schema("public")
}

model TourPrice {
  id             Int       @id @default(autoincrement())
  numOfPeople    Int       @default(0)
  currency       String
  pricePerPerson Float     @default(0)
  seasonName     String?
  seasonPeriod   String?
  dateCreated    DateTime  @default(now())
  dateModified   DateTime? @updatedAt
  tourId         Int
  tourUniqueId   String
  tour           Tour      @relation(fields: [tourId, tourUniqueId], references: [id, uniqueId], onDelete: Cascade)

  @@index([tourId, tourUniqueId])
  @@map("tour_prices")
  @@schema("public")
}

model Tour {
  id                Int         @id @default(autoincrement())
  uniqueId          String      @unique
  title             String
  description       String?
  location          String?
  countryId         Int?
  country           Country?    @relation(fields: [countryId], references: [id])
  durationInDays    Int         @default(0)
  itinerary         String?
  accommodationType String?
  siteURL           String?
  included          String?
  excluded          String?
  dateCreated       DateTime    @default(now())
  dateModified      DateTime?   @updatedAt
  archived          Boolean     @default(false)
  images            TourImage[]
  prices            TourPrice[]
  operatorId        Int?
  operator          Operator?   @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  tourParks TourPark[]
  tourCategories TourCategory[]

  @@index([countryId])
  @@index([operatorId])
  @@unique([id, uniqueId])
  @@map("tours")
  @@schema("public")
}

// CATEGORY & TOUR LINKAGE MODELS
model ConflictGroup {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  dateCreated DateTime  @default(now())
  // Relations
  categories  Category[]

  @@map("conflict_groups")
  @@schema("public")
}

model Tag {
  id       Int    @id @default(autoincrement())
  key      String @unique
  label    String
  category String

  @@map("tags")
  @@schema("public")
}

model Category {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  description      String?
  isActive         Boolean   @default(true)
  conflictGroupId  Int?
  conflictGroup    ConflictGroup? @relation(fields: [conflictGroupId], references: [id])
  dateCreated      DateTime  @default(now())
  dateModified     DateTime? @updatedAt
  // Relations
  tourCategories   TourCategory[]
  quizOptions      QuizOption[]

  @@map("categories")
  @@schema("public")
}

model TourCategory {
  tourId        Int
  tourUniqueId  String
  categoryId    Int
  weight        Float      @default(1.0)
  dateCreated   DateTime   @default(now())
  // Relations
  tour          Tour       @relation(fields: [tourId, tourUniqueId], references: [id, uniqueId], onDelete: Cascade)
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tourId, tourUniqueId, categoryId])
  @@map("tour_categories")
  @@schema("public")
}

// Quiz/Recommendation Engine Models
model QuizStage {
  id          Int            @id @default(autoincrement())
  name        String          @unique
  description String?
  orderIndex  Int             @default(1)
  isActive    Boolean         @default(true)
  dateCreated DateTime        @default(now())
  // Relations
  questions   QuizQuestion[]  @relation("StageQuestions")
  responses   QuizResponse[]

  @@map("quiz_stages")
  @@schema("public")
}

model QuizResponse {
  id               Int           @id @default(autoincrement())
  userId           Int?
  sessionId        String
  stageId          Int?
  confidenceLevel  Int?
  quizSelections   Json?
  dateCreated      DateTime      @default(now())
  // Relations
  stage             QuizStage?    @relation(fields: [stageId], references: [id])
  answers           QuizAnswer[]
  recommendedPersona QuizPersona? @relation("PersonaResponses", fields: [personaId], references: [id])
  personaId         Int?

  @@index([sessionId])
  @@map("quiz_responses")
  @@schema("public")
}

model QuizPersona {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  keyTraits   String[]
  tagMapping  String[]
  imageUrl    String?
  dateCreated DateTime         @default(now())
  // Relations
  responses   QuizResponse[]   @relation("PersonaResponses")

  @@map("quiz_personas")
  @@schema("public")
}

model QuizQuestion {
  id          Int             @id @default(autoincrement())
  question    String
  description String?
  orderIndex  Int             @unique
  isActive    Boolean         @default(true)
  dateCreated DateTime        @default(now())
  // Relations
  stageId     Int?
  stage       QuizStage?      @relation("StageQuestions", fields: [stageId], references: [id])
  options     QuizOption[]
  insights    QuizInsight[]   @relation("QuestionInsights")

  @@map("quiz_questions")
  @@schema("public")
}

model QuizOption {
  id          Int             @id @default(autoincrement())
  questionId  Int
  categoryId  Int
  optionText  String
  orderIndex  Int
  isActive    Boolean         @default(true)
  dateCreated DateTime        @default(now())
  // Relations
  question    QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  insights    QuizInsight[]   @relation("OptionInsights")

  @@unique([questionId, categoryId])
  @@map("quiz_options")
  @@schema("public")
}

model QuizInsight {
  id           Int           @id @default(autoincrement())
  questionId   Int?
  optionId     Int?
  insightText  String
  contextType  String?
  dateCreated  DateTime      @default(now())
  // Relations
  question     QuizQuestion? @relation("QuestionInsights", fields: [questionId], references: [id], onDelete: Cascade)
  option       QuizOption?   @relation("OptionInsights", fields: [optionId], references: [id], onDelete: Cascade)

  @@map("quiz_insights")
  @@schema("public")
}

model QuizAnswer {
  id             Int       @id @default(autoincrement())
  responseId     Int
  questionId     Int
  selectedOption Int
  dateCreated    DateTime  @default(now())
  // Relations
  response QuizResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@map("quiz_answers")
  @@schema("public")
}

model QuizConfig {
  id                       Int     @id @default(autoincrement())
  mandatoryCategoriesCount Int     @default(2) @map("mandatory_categories_count")
  isActive                 Boolean @default(true) @map("is_active")

  @@map("quiz_config")
  @@schema("public")
}
